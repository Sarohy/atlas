# Required environment variables for ATLAS backend.
# Copy this file to .env and fill in the values.

# Application
APP_NAME=atlas-backend
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL — async URL using asyncpg driver
DATABASE_URL=postgresql+asyncpg://<your-pg-user>@localhost:5432/atlas_dev

# Test database (used by integration test fixtures)
TEST_DATABASE_URL=postgresql+asyncpg://<your-pg-user>@localhost:5432/atlas_test

# Polygon.io — get a free key at https://polygon.io/
POLYGON_API_KEY=


ALPHAVANTAGE_API_KEY=
EARNINGS_TRANSCRIPT_API_KEY=
BENZINGA_API_KEY=
UNUSUAL_WHALES_API_KEY=